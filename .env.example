# ============================================================
# SATQUERY AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# 1. Google Gemini (Backend AI Reasoning)
GEMINI_API_KEY=

# 2. Hindsight Cloud Agent Memory (Backend Long-Term Memory)
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=satquery-intelligence-bank

# 3. Supabase Backend (Application Database, Auth, Storage)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# CRITICAL: Backend-only secret key. NEVER expose to frontend!
SUPABASE_SECRET_KEY=

# 4. Supabase Frontend (Client-Safe Publishable Variables Only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 5. Legacy Aliases (Backward-compatible fallback support)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_ANON_KEY=

# 6. Optional Client Basemap Key (CARTO Voyager basemaps)
VITE_CARTO_API_KEY=

# 7. Earth Observation STAC Catalogues (Public Open Access)
EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# 8. Geocoding Service
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# 9. Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
